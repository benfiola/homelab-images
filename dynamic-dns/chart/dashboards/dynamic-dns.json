  "templating": {
    "list": [
      {
        "current": {},
        "label": "Data source",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Namespace",
        "name": "namespace",
        "query": {
          "query": "label_values(dynamic_dns_record_updates_total, namespace)",
