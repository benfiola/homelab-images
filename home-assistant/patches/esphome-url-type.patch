diff --git a/homeassistant/components/esphome/url.py b/homeassistant/components/esphome/url.py
new file mode 100644
index 00000000000..77bbbce3145
--- /dev/null
+++ b/homeassistant/components/esphome/url.py
@@ -0,0 +1,21 @@
+"""Helpers for building URLs that are sent to ESPHome devices."""
+
+from __future__ import annotations
+
+from homeassistant.components.media_player import async_process_play_media_url
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers.network import get_url
+
+from .const import CONF_URL_TYPE, DEFAULT_URL_TYPE, URL_TYPE_AUTO, URL_TYPE_EXTERNAL
+
+
+def async_process_device_media_url(
+    hass: HomeAssistant, entry_id: str, media_content_id: str
+) -> str:
+    """Sign a media URL for a device, honoring its configured URL type."""
+    entry = hass.config_entries.async_get_entry(entry_id)
+    url_type = entry.options.get(CONF_URL_TYPE, DEFAULT_URL_TYPE) if entry else None
+    if url_type not in (None, URL_TYPE_AUTO) and media_content_id.startswith("/"):
+        base_url = get_url(hass, prefer_external=url_type == URL_TYPE_EXTERNAL)
+        media_content_id = f"{base_url}{media_content_id}"
+    return async_process_play_media_url(hass, media_content_id)
